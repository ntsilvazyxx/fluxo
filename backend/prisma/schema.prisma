generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoleCode {
  ADMIN_MASTER
  SECRETARY
  MANAGER
  TECHNICIAN
}

enum TaskCycleStatus {
  PENDING
  AWAITING_ACCEPTANCE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssignmentEndReason {
  REJECTED
  REASSIGNED
  RETURN_APPROVED
  COMPLETED
  CANCELLED
}

enum TaskRequestType {
  RETURN
  EXTENSION
}

enum TaskRequestStatus {
  PENDING
  APPROVED
  DENIED
  CLOSED_BY_COMPLETION
  CLOSED_BY_ADMIN_CHANGE
  CLOSED_BY_REASSIGNMENT
  CLOSED_BY_CANCELLATION
}

enum CalendarExceptionType {
  HOLIDAY
  WORKING_PERIOD
}

enum DeadlinePolicy {
  LEGACY_CALENDAR
  RUNNING_CLOCK
}

enum DeadlineChangeKind {
  LEGACY
  EXECUTION_EXTENSION
  RETURN_PAUSE
  ADMINISTRATIVE
}

enum TaskAttachmentOrigin {
  INITIAL
  EXECUTION
}

enum StagedUploadStatus {
  STAGED
  CLAIMED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum IdempotencyState {
  PROCESSING
  COMPLETED
  FAILED
}

enum MfaCredentialType {
  TOTP
  WEBAUTHN
}

model Role {
  id        String   @id @db.Char(36)
  code      RoleCode @unique
  label     String   @db.VarChar(80)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  users     User[]

  @@map("roles")
}

model User {
  id                       String                    @id @db.Char(36)
  name                     String                    @db.VarChar(160)
  emailNormalized          String                    @unique @db.VarChar(254)
  passwordHash             String                    @db.VarChar(255)
  roleId                   String                    @db.Char(36)
  isActive                 Boolean                   @default(true)
  version                  Int                       @default(0) @db.UnsignedInt
  createdAt                DateTime                  @default(now()) @db.DateTime(3)
  updatedAt                DateTime                  @updatedAt @db.DateTime(3)
  deletedAt                DateTime?                 @db.DateTime(3)
  role                     Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships              TeamMember[]
  managedTeams             TeamManager[]
  createdTasks             Task[]                    @relation("TaskCreator")
  assignments              TaskAssignment[]          @relation("AssignmentResponsible")
  assignmentsCreated       TaskAssignment[]          @relation("AssignmentAuthor")
  requestsDecided          TaskRequest[]             @relation("RequestDecider")
  deadlineChanges          DeadlineChange[]          @relation("DeadlineChangeAuthor")
  imagesUploaded           TaskImage[]               @relation("TaskImageUploader")
  attachmentsUploaded      TaskAttachment[]          @relation("TaskAttachmentUploader")
  stagedUploads            StagedUpload[]
  cycleNotes               TaskCycleNote[]           @relation("TaskCycleNoteAuthor")
  calendarVersionsCreated  CalendarVersion[]         @relation("CalendarVersionAuthor")
  auditEvents              AuditEvent[]              @relation("AuditActor")
  notifications            Notification[]
  idempotencyKeys          IdempotencyKey[]
  sessions                 UserSession[]
  legacyAuthChallenges     LegacyAuthChallenge[]     @ignore
  passwordResetTokens      PasswordResetToken[]
  legacyMfaCredentials     LegacyMfaCredential[]     @ignore
  notificationPreferences  NotificationPreference[]
  taskPreferences          UserTaskPreference[]
  taskComments             TaskComment[]             @relation("TaskCommentAuthor")
  settingsUpdated          SystemSetting[]           @relation("SystemSettingUpdater")
  chatParticipants         ChatParticipant[]         @relation("UserChatParticipants")
  chatPeriodsAdded         ChatParticipationPeriod[] @relation("PeriodAddedBy")
  chatPeriodsRemoved       ChatParticipationPeriod[] @relation("PeriodRemovedBy")
  authoredChatMessages     ChatMessage[]             @relation("UserAuthoredChatMessages")
  chatFunctionalReadStates ChatFunctionalReadState[] @relation("UserChatFunctionalReadStates")
  chatLocks                ChatLockState[]           @relation("UserChatLocks")
  chatLockEvents           ChatLockEvent[]           @relation("UserChatLockEvents")
  chatAttachmentUploads    ChatAttachmentUpload[]    @relation("UserChatAttachmentUploads")
  chatMessageAttachments   ChatMessageAttachment[]   @relation("UserChatMessageAttachments")

  @@index([roleId, isActive])
  @@index([name])
  @@map("users")
}

model Team {
  id            String        @id @db.Char(36)
  name          String        @db.VarChar(160)
  isActive      Boolean       @default(true)
  calendarId    String?       @unique @db.Char(36)
  version       Int           @default(0) @db.UnsignedInt
  createdAt     DateTime      @default(now()) @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @db.DateTime(3)
  calendar      WorkCalendar? @relation("TeamCalendarPointer", fields: [calendarId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownedCalendar WorkCalendar? @relation("CalendarTeamOwner")
  memberships   TeamMember[]
  managers      TeamManager[]
  tasks         Task[]

  @@index([isActive, name])
  @@map("teams")
}

model TeamMember {
  id        String    @id @db.Char(36)
  teamId    String    @db.Char(36)
  userId    String    @db.Char(36)
  joinedAt  DateTime  @db.DateTime(3)
  leftAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teamId, leftAt])
  @@index([userId, leftAt])
  @@map("team_members")
}

model TeamManager {
  id         String    @id @db.Char(36)
  teamId     String    @db.Char(36)
  userId     String    @db.Char(36)
  assignedAt DateTime  @db.DateTime(3)
  endedAt    DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teamId, endedAt])
  @@index([userId, endedAt])
  @@map("team_managers")
}

model WorkCalendar {
  id              String            @id @db.Char(36)
  teamId          String            @unique @db.Char(36)
  timezone        String            @db.VarChar(64)
  activeVersionId String?           @unique @db.Char(36)
  version         Int               @default(0) @db.UnsignedInt
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @db.DateTime(3)
  team            Team              @relation("CalendarTeamOwner", fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedByTeam  Team?             @relation("TeamCalendarPointer")
  activeVersion   CalendarVersion?  @relation("CalendarActiveVersion", fields: [activeVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions        CalendarVersion[] @relation("CalendarVersions")

  @@map("work_calendars")
}

model CalendarVersion {
  id                String              @id @db.Char(36)
  calendarId        String              @db.Char(36)
  versionNumber     Int                 @db.UnsignedInt
  effectiveFrom     DateTime            @db.DateTime(3)
  effectiveTo       DateTime?           @db.DateTime(3)
  publishedAt       DateTime?           @db.DateTime(3)
  createdById       String              @db.Char(36)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  calendar          WorkCalendar        @relation("CalendarVersions", fields: [calendarId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeForCalendar WorkCalendar?       @relation("CalendarActiveVersion")
  createdBy         User                @relation("CalendarVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  schedules         WorkSchedule[]
  exceptions        CalendarException[]
  assignments       TaskAssignment[]

  @@unique([calendarId, versionNumber])
  @@unique([id, calendarId])
  @@index([calendarId, effectiveFrom, effectiveTo])
  @@map("calendar_versions")
}

model WorkSchedule {
  id                String          @id @db.Char(36)
  calendarVersionId String          @db.Char(36)
  weekday           Int             @db.UnsignedTinyInt
  startMinute       Int             @db.UnsignedSmallInt
  endMinute         Int             @db.UnsignedSmallInt
  calendarVersion   CalendarVersion @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([calendarVersionId, weekday, startMinute, endMinute])
  @@index([calendarVersionId, weekday])
  @@map("work_schedules")
}

model CalendarException {
  id                String                @id @db.Char(36)
  calendarVersionId String                @db.Char(36)
  localDate         DateTime              @db.Date
  type              CalendarExceptionType
  startMinute       Int?                  @db.UnsignedSmallInt
  endMinute         Int?                  @db.UnsignedSmallInt
  description       String?               @db.VarChar(255)
  calendarVersion   CalendarVersion       @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([calendarVersionId, localDate])
  @@map("calendar_exceptions")
}

model Task {
  id                   String               @id @db.Char(36)
  publicNumber         BigInt               @unique @default(autoincrement()) @db.UnsignedBigInt
  teamId               String               @db.Char(36)
  createdById          String               @db.Char(36)
  sigadocProcessNumber String?              @db.VarChar(128)
  sigadocProcessLink   String?              @db.VarChar(2048)
  parentCycleId        String?              @db.Char(36)
  currentCycleId       String?              @unique @db.Char(36)
  version              Int                  @default(0) @db.UnsignedInt
  createdAt            DateTime             @default(now()) @db.DateTime(3)
  updatedAt            DateTime             @updatedAt @db.DateTime(3)
  deletedAt            DateTime?            @db.DateTime(3)
  team                 Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy            User                 @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parentCycle          TaskCycle?           @relation("CycleSubtasks", fields: [parentCycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentCycle         TaskCycle?           @relation("TaskCurrentCycle", fields: [currentCycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycles               TaskCycle[]          @relation("TaskCycles")
  userPreferences      UserTaskPreference[]
  comments             TaskComment[]        @relation("TaskComments")
  chatConversation     ChatConversation?

  @@index([teamId, deletedAt])
  @@index([createdById])
  @@index([parentCycleId])
  @@map("tasks")
}

model TaskCycle {
  id                        String           @id @db.Char(36)
  taskId                    String           @db.Char(36)
  cycleNumber               Int              @db.UnsignedInt
  title                     String           @db.VarChar(255)
  description               String           @db.Text
  priority                  TaskPriority     @default(NORMAL)
  status                    TaskCycleStatus  @default(PENDING)
  deadlinePolicy            DeadlinePolicy   @default(LEGACY_CALENDAR)
  acceptanceDurationMinutes Int?             @db.UnsignedInt
  executionDurationMinutes  Int?             @db.UnsignedInt
  acceptanceDeadlineAt      DateTime?        @db.DateTime(3)
  executionDeadlineAt       DateTime?        @db.DateTime(3)
  deadlineAt                DateTime?        @db.DateTime(3)
  version                   Int              @default(0) @db.UnsignedInt
  openedAt                  DateTime         @db.DateTime(3)
  closedAt                  DateTime?        @db.DateTime(3)
  completionText            String?          @db.Text
  createdAt                 DateTime         @default(now()) @db.DateTime(3)
  updatedAt                 DateTime         @updatedAt @db.DateTime(3)
  task                      Task             @relation("TaskCycles", fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentForTask            Task?            @relation("TaskCurrentCycle")
  subtasks                  Task[]           @relation("CycleSubtasks")
  assignments               TaskAssignment[]
  requests                  TaskRequest[]
  deadlineChanges           DeadlineChange[]
  images                    TaskImage[]
  attachments               TaskAttachment[]
  notes                     TaskCycleNote[]
  chatMessages              ChatMessage[]
  chatLockStates            ChatLockState[]
  chatLockEvents            ChatLockEvent[]

  @@unique([taskId, cycleNumber])
  @@unique([id, taskId])
  @@index([status, deadlineAt])
  @@index([status, acceptanceDeadlineAt])
  @@index([status, executionDeadlineAt])
  @@index([priority, status])
  @@map("task_cycles")
}

model TaskAssignment {
  id                   String               @id @db.Char(36)
  cycleId              String               @db.Char(36)
  userId               String               @db.Char(36)
  assignedById         String               @db.Char(36)
  calendarVersionId    String?              @db.Char(36)
  acceptanceDeadlineAt DateTime?            @db.DateTime(3)
  assignedAt           DateTime             @db.DateTime(3)
  acceptedAt           DateTime?            @db.DateTime(3)
  endedAt              DateTime?            @db.DateTime(3)
  endReason            AssignmentEndReason?
  createdAt            DateTime             @default(now()) @db.DateTime(3)
  cycle                TaskCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                 User                 @relation("AssignmentResponsible", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy           User                 @relation("AssignmentAuthor", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calendarVersion      CalendarVersion?     @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requests             TaskRequest[]
  pauseIntervals       TaskPauseInterval[]

  @@unique([id, cycleId])
  @@index([cycleId, endedAt])
  @@index([userId, endedAt])
  @@index([calendarVersionId])
  @@map("task_assignments")
}

model TaskRequest {
  id                 String              @id @db.Char(36)
  cycleId            String              @db.Char(36)
  assignmentId       String              @db.Char(36)
  type               TaskRequestType
  status             TaskRequestStatus   @default(PENDING)
  reason             String              @db.Text
  proposedDeadlineAt DateTime?           @db.DateTime(3)
  decidedById        String?             @db.Char(36)
  decidedAt          DateTime?           @db.DateTime(3)
  decisionReason     String?             @db.Text
  createdAt          DateTime            @default(now()) @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @db.DateTime(3)
  cycle              TaskCycle           @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignment         TaskAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy          User?               @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pauseIntervals     TaskPauseInterval[]
  chatLockEvents     ChatLockEvent[]

  @@index([assignmentId, type, status])
  @@index([cycleId, status])
  @@index([decidedById])
  @@map("task_requests")
}

model TaskPauseInterval {
  id           String         @id @db.Char(36)
  assignmentId String         @db.Char(36)
  requestId    String         @db.Char(36)
  startedAt    DateTime       @db.DateTime(3)
  endedAt      DateTime?      @db.DateTime(3)
  createdAt    DateTime       @default(now()) @db.DateTime(3)
  assignment   TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request      TaskRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, startedAt])
  @@index([assignmentId, endedAt])
  @@map("task_pause_intervals")
}

model DeadlineChange {
  id            String             @id @db.Char(36)
  cycleId       String             @db.Char(36)
  oldDeadlineAt DateTime?          @db.DateTime(3)
  newDeadlineAt DateTime           @db.DateTime(3)
  kind          DeadlineChangeKind @default(LEGACY)
  reason        String             @db.Text
  changedById   String             @db.Char(36)
  createdAt     DateTime           @default(now()) @db.DateTime(3)
  cycle         TaskCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedBy     User               @relation("DeadlineChangeAuthor", fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cycleId, createdAt])
  @@index([cycleId, kind, createdAt])
  @@index([changedById])
  @@map("deadline_changes")
}

model TaskImage {
  id           String    @id @db.Char(36)
  cycleId      String    @db.Char(36)
  uploadedById String    @db.Char(36)
  storageKey   String    @unique @db.VarChar(512)
  mimeType     String    @db.VarChar(100)
  sizeBytes    BigInt    @db.UnsignedBigInt
  checksum     String    @db.Char(64)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  deletedAt    DateTime? @db.DateTime(3)
  cycle        TaskCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   User      @relation("TaskImageUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cycleId, deletedAt])
  @@index([uploadedById])
  @@map("task_images")
}

model TaskAttachment {
  id           String               @id @db.Char(36)
  cycleId      String               @db.Char(36)
  uploadedById String               @db.Char(36)
  origin       TaskAttachmentOrigin
  originalName String               @db.VarChar(255)
  storageKey   String               @unique @db.VarChar(512)
  mimeType     String               @db.VarChar(100)
  sizeBytes    BigInt               @db.UnsignedBigInt
  checksum     String               @db.Char(64)
  createdAt    DateTime             @default(now()) @db.DateTime(3)
  deletedAt    DateTime?            @db.DateTime(3)
  cycle        TaskCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   User                 @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cycleId, origin, deletedAt])
  @@index([uploadedById])
  @@map("task_attachments")
}

model StagedUpload {
  id           String             @id @db.Char(36)
  uploadedById String             @db.Char(36)
  originalName String             @db.VarChar(255)
  stagingKey   String             @unique @db.VarChar(512)
  mimeType     String             @db.VarChar(100)
  sizeBytes    BigInt             @db.UnsignedBigInt
  checksum     String             @db.Char(64)
  status       StagedUploadStatus @default(STAGED)
  expiresAt    DateTime           @db.DateTime(3)
  claimedAt    DateTime?          @db.DateTime(3)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([uploadedById, status, expiresAt])
  @@index([status, expiresAt])
  @@map("staged_uploads")
}

model TaskCycleNote {
  id        String    @id @db.Char(36)
  cycleId   String    @db.Char(36)
  authorId  String    @db.Char(36)
  content   String    @db.Text
  reason    String    @db.Text
  createdAt DateTime  @default(now()) @db.DateTime(3)
  cycle     TaskCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User      @relation("TaskCycleNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cycleId, createdAt])
  @@index([authorId])
  @@map("task_cycle_notes")
}

model AuditEvent {
  id            String   @id @db.Char(36)
  actorId       String?  @db.Char(36)
  entityType    String   @db.VarChar(100)
  entityId      String   @db.Char(36)
  action        String   @db.VarChar(100)
  beforeJson    Json?
  afterJson     Json?
  reason        String?  @db.Text
  correlationId String   @db.Char(36)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

model Notification {
  id         String    @id @db.Char(36)
  userId     String    @db.Char(36)
  type       String    @db.VarChar(100)
  title      String    @db.VarChar(180)
  body       String    @db.Text
  entityType String    @db.VarChar(100)
  entityId   String    @db.Char(36)
  readAt     DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, readAt, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model OutboxEvent {
  id            String          @id @db.Char(36)
  eventType     String          @db.VarChar(120)
  payloadJson   Json
  dedupeKey     String          @unique @db.VarChar(255)
  status        OutboxStatus    @default(PENDING)
  attempts      Int             @default(0) @db.UnsignedInt
  nextAttemptAt DateTime?       @db.DateTime(3)
  claimedAt     DateTime?       @db.DateTime(3)
  processedAt   DateTime?       @db.DateTime(3)
  lastError     String?         @db.Text
  createdAt     DateTime        @default(now()) @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @db.DateTime(3)
  deliveries    EmailDelivery[]

  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

model EmailDelivery {
  id            String              @id @db.Char(36)
  outboxEventId String              @db.Char(36)
  recipient     String              @db.VarChar(254)
  status        EmailDeliveryStatus @default(PENDING)
  attemptCount  Int                 @default(0) @db.UnsignedInt
  lastError     String?             @db.Text
  sentAt        DateTime?           @db.DateTime(3)
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @db.DateTime(3)
  outboxEvent   OutboxEvent         @relation(fields: [outboxEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([outboxEventId, recipient])
  @@index([status, createdAt])
  @@map("email_deliveries")
}

model IdempotencyKey {
  id               String           @id @db.Char(36)
  actorId          String           @db.Char(36)
  key              String           @db.VarChar(255)
  requestHash      String           @db.Char(64)
  responseStatus   Int?             @db.UnsignedSmallInt
  responseBodyJson Json?
  state            IdempotencyState @default(PROCESSING)
  expiresAt        DateTime         @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)
  actor            User             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model UserSession {
  id                  String    @id @db.Char(36)
  userId              String    @db.Char(36)
  refreshTokenHash    String    @unique @db.Char(64)
  createdAt           DateTime  @default(now()) @db.DateTime(3)
  expiresAt           DateTime  @db.DateTime(3)
  revokedAt           DateTime? @db.DateTime(3)
  legacyMfaVerifiedAt DateTime? @ignore @db.DateTime(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

// Archived only: no generated client delegate or runtime authentication use.
model LegacyAuthChallenge {
  id               String    @id @db.Char(36)
  userId           String    @db.Char(36)
  tokenHash        String    @unique(map: "auth_challenges_tokenHash_key") @db.Char(64)
  userVersion      Int       @db.UnsignedInt
  enrollmentSecret String?   @db.Text
  attempts         Int       @default(0) @db.UnsignedInt
  expiresAt        DateTime  @db.DateTime(3)
  consumedAt       DateTime? @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "auth_challenges_userId_fkey")

  @@index([userId, expiresAt], map: "auth_challenges_userId_expiresAt_idx")
  @@map("legacy_mfa_auth_challenges")
  @@ignore
}

model PasswordResetToken {
  id        String    @id @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model LegacyMfaCredential {
  id               String            @id @db.Char(36)
  userId           String            @db.Char(36)
  type             MfaCredentialType
  credentialId     String?           @unique(map: "mfa_credentials_credentialId_key") @db.VarChar(512)
  secretCiphertext String?           @db.Text
  credentialJson   Json?
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  lastUsedAt       DateTime?         @db.DateTime(3)
  revokedAt        DateTime?         @db.DateTime(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "mfa_credentials_userId_fkey")

  @@index([userId, revokedAt], map: "mfa_credentials_userId_revokedAt_idx")
  @@map("legacy_mfa_credentials")
  @@ignore
}

model NotificationPreference {
  id               String  @id @db.Char(36)
  userId           String  @db.Char(36)
  notificationType String  @db.VarChar(100)
  internalEnabled  Boolean @default(true)
  emailEnabled     Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, notificationType])
  @@map("notification_preferences")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  valueJson   Json
  description String?  @db.VarChar(255)
  version     Int      @default(0) @db.UnsignedInt
  updatedById String?  @db.Char(36)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  updatedBy   User?    @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedById])
  @@map("system_settings")
}

model UserTaskPreference {
  id        String   @id @db.Char(36)
  userId    String   @db.Char(36)
  taskId    String   @db.Char(36)
  color     String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@map("user_task_preferences")
}

model TaskComment {
  id              String   @id @db.Char(36)
  taskId          String   @db.Char(36)
  authorId        String   @db.Char(36)
  content         String   @db.Text
  clientMessageId String?  @unique @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  task   Task @relation("TaskComments", fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("task_comments")
}

// ============================================================================
// CHAT DE TAREFAS — ENUMS
// ============================================================================

enum ChatParticipationEndReason {
  REASSIGNED
  REMOVED_BY_MANAGER
  ACCOUNT_DEACTIVATED
  ASSIGNMENT_REJECTED
  CYCLE_ENDED
}

enum ChatMessageStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ChatMessageAttachmentOrigin {
  UPLOAD
  SYSTEM_GENERATED
}

enum ChatAttachmentUploadStatus {
  STAGED
  READY
  CLAIMED
  PROMOTED
  REJECTED
  FAILED
  EXPIRED
}

enum ChatLockReason {
  REQUEST_PENDING
  CYCLE_CLOSED
  ADMIN_MAINTENANCE
}

enum ChatLockEventType {
  LOCK_ACQUIRED
  LOCK_REASSERTED
  LOCK_RELEASED
  DECISION_RECORDED_WHILE_UNLOCKED
  CYCLE_TERMINATED
  CYCLE_REOPENED
  ADMIN_INTERVENTION
}

// ============================================================================
// CHAT DE TAREFAS — MODELOS DE PERSISTÊNCIA
// ============================================================================

/// Conversa única do Chat de Tarefas, vinculada 1:1 com a Tarefa raiz.
model ChatConversation {
  id        String   @id @default(uuid()) @db.Char(36)
  taskId    String   @unique @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  task                 Task                      @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participants         ChatParticipant[]
  messages             ChatMessage[]
  readReceipts         ChatReadReceipt[]
  functionalReadStates ChatFunctionalReadState[]
  lockState            ChatLockState?
  lockEvents           ChatLockEvent[]
  attachmentUploads    ChatAttachmentUpload[]

  @@map("chat_conversations")
}

/// Vínculo formal único entre usuário e conversa da tarefa.
model ChatParticipant {
  id             String   @id @default(uuid()) @db.Char(36)
  conversationId String   @db.Char(36)
  userId         String   @db.Char(36)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  conversation ChatConversation          @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User                      @relation("UserChatParticipants", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  periods      ChatParticipationPeriod[]
  readReceipt  ChatReadReceipt?

  @@unique([conversationId, userId])
  @@unique([id, conversationId])
  @@index([userId])
  @@map("chat_participants")
}

/// Histórico formal de períodos de permanência do participante na conversa.
model ChatParticipationPeriod {
  id            String                      @id @default(uuid()) @db.Char(36)
  participantId String                      @db.Char(36)
  joinedAt      DateTime                    @default(now()) @db.DateTime(3)
  endedAt       DateTime?                   @db.DateTime(3)
  endReason     ChatParticipationEndReason?
  addedById     String                      @db.Char(36)
  removedById   String?                     @db.Char(36)
  createdAt     DateTime                    @default(now()) @db.DateTime(3)

  participant ChatParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedBy     User            @relation("PeriodAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedBy   User?           @relation("PeriodRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([participantId, joinedAt])
  @@index([endedAt])
  @@index([addedById])
  @@index([removedById])
  @@map("chat_participation_periods")
}

/// Mensagem enviada na conversa, associada ao ciclo da tarefa.
model ChatMessage {
  id                           String            @id @default(uuid()) @db.Char(36)
  conversationId               String            @db.Char(36)
  cycleId                      String            @db.Char(36)
  authorId                     String            @db.Char(36)
  sequenceNumber               BigInt            @db.UnsignedBigInt
  clientMessageId              String            @db.Char(36)
  content                      String?           @db.Text
  status                       ChatMessageStatus @default(PENDING)
  reconciliationClaimToken     String?           @db.Char(36)
  reconciliationClaimedAt      DateTime?         @db.DateTime(3)
  reconciliationClaimExpiresAt DateTime?         @db.DateTime(3)
  reconciliationAttempts       Int               @default(0) @db.TinyInt
  failureReason                String?           @db.VarChar(255)
  createdAt                    DateTime          @default(now()) @db.DateTime(3)
  publishedAt                  DateTime?         @db.DateTime(3)

  conversation        ChatConversation          @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle               TaskCycle                 @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author              User                      @relation("UserAuthoredChatMessages", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments         ChatMessageAttachment[]
  attachmentUploads   ChatAttachmentUpload[]
  receiptLastReads    ChatReadReceipt[]         @relation("ReceiptLastReadMessage")
  functionalLastReads ChatFunctionalReadState[] @relation("FunctionalLastReadMessage")

  @@unique([conversationId, sequenceNumber])
  @@unique([conversationId, clientMessageId])
  @@unique([id, conversationId])
  @@index([cycleId])
  @@index([authorId])
  @@index([status, createdAt])
  @@index([reconciliationClaimExpiresAt])
  @@map("chat_messages")
}

/// Anexo físico exclusivo de mensagens do chat.
model ChatMessageAttachment {
  id             String                      @id @default(uuid()) @db.Char(36)
  messageId      String                      @db.Char(36)
  sourceUploadId String?                     @unique @db.Char(36)
  uploadedById   String?                     @db.Char(36)
  position       Int?                        @db.UnsignedSmallInt
  originalName   String                      @db.VarChar(255)
  storagePath    String                      @unique @db.VarChar(500)
  mimeType       String                      @db.VarChar(127)
  sizeBytes      BigInt                      @db.UnsignedBigInt
  sha256         String                      @db.Char(64)
  origin         ChatMessageAttachmentOrigin @default(UPLOAD)
  createdAt      DateTime                    @default(now()) @db.DateTime(3)

  message      ChatMessage           @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceUpload ChatAttachmentUpload? @relation(fields: [sourceUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   User?                 @relation("UserChatMessageAttachments", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([messageId])
  @@unique([messageId, position])
  @@index([uploadedById])
  @@map("chat_message_attachments")
}

/// Upload temporário privado. CLAIMED/PROMOTED são reservados à Fase 5.1.3.
model ChatAttachmentUpload {
  id               String                     @id @default(uuid()) @db.Char(36)
  conversationId   String                     @db.Char(36)
  uploadedById     String                     @db.Char(36)
  clientUploadId   String                     @db.Char(36)
  messageId        String?                    @db.Char(36)
  originalName     String                     @db.VarChar(255)
  stagingKey       String                     @unique @db.VarChar(180)
  targetStorageKey String?                    @unique @db.VarChar(180)
  mimeType         String                     @db.VarChar(127)
  extension        String                     @db.VarChar(10)
  sizeBytes        BigInt                     @db.UnsignedBigInt
  sha256           String                     @db.Char(64)
  status           ChatAttachmentUploadStatus @default(STAGED)
  expiresAt        DateTime                   @db.DateTime(3)
  claimedAt        DateTime?                  @db.DateTime(3)
  promotedAt       DateTime?                  @db.DateTime(3)
  failedAt         DateTime?                  @db.DateTime(3)
  attemptCount     Int                        @default(0) @db.UnsignedSmallInt
  failureCode      String?                    @db.VarChar(100)
  createdAt        DateTime                   @default(now()) @db.DateTime(3)
  updatedAt        DateTime                   @updatedAt @db.DateTime(3)

  conversation    ChatConversation       @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy      User                   @relation("UserChatAttachmentUploads", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  message         ChatMessage?           @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Restrict, onUpdate: Restrict)
  finalAttachment ChatMessageAttachment?

  @@unique([conversationId, uploadedById, clientUploadId])
  @@index([status, expiresAt])
  @@index([uploadedById, status, expiresAt])
  @@index([conversationId, status, expiresAt])
  @@index([messageId, status])
  @@map("chat_attachment_uploads")
}

/// Ponteiro de leitura para participantes formais da conversa.
model ChatReadReceipt {
  id                String    @id @default(uuid()) @db.Char(36)
  conversationId    String    @db.Char(36)
  participantId     String    @unique @db.Char(36)
  lastReadMessageId String?   @db.Char(36)
  lastReadSequence  BigInt    @default(0) @db.UnsignedBigInt
  lastReadAt        DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  participant     ChatParticipant  @relation(fields: [participantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastReadMessage ChatMessage?     @relation("ReceiptLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([conversationId])
  @@index([lastReadMessageId])
  @@map("chat_read_receipts")
}

/// Ponteiro de leitura funcional para gestores e observadores autorizados.
model ChatFunctionalReadState {
  id                String    @id @default(uuid()) @db.Char(36)
  conversationId    String    @db.Char(36)
  userId            String    @db.Char(36)
  lastReadMessageId String?   @db.Char(36)
  lastReadSequence  BigInt    @default(0) @db.UnsignedBigInt
  lastReadAt        DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user            User             @relation("UserChatFunctionalReadStates", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastReadMessage ChatMessage?     @relation("FunctionalLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([lastReadMessageId])
  @@map("chat_functional_read_states")
}

/// Estado operacional de bloqueio da conversa vinculado ao ciclo vigente da tarefa.
model ChatLockState {
  id             String          @id @default(uuid()) @db.Char(36)
  conversationId String          @unique @db.Char(36)
  cycleId        String          @db.Char(36)
  isLocked       Boolean         @default(false)
  reason         ChatLockReason?
  requestId      String?         @db.Char(36)
  lockedAt       DateTime?       @db.DateTime(3)
  lockedById     String?         @db.Char(36)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle        TaskCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lockedBy     User?            @relation("UserChatLocks", fields: [lockedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cycleId])
  @@index([lockedById])
  @@map("chat_lock_states")
}

/// Histórico imutável de eventos de bloqueio e desbloqueio.
model ChatLockEvent {
  id             String            @id @default(uuid()) @db.Char(36)
  conversationId String            @db.Char(36)
  cycleId        String            @db.Char(36)
  eventType      ChatLockEventType
  actorId        String?           @db.Char(36)
  reason         ChatLockReason?
  requestId      String?           @db.Char(36)
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.DateTime(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle        TaskCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User?            @relation("UserChatLockEvents", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  request      TaskRequest?     @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([conversationId, createdAt])
  @@index([cycleId])
  @@index([actorId])
  @@index([requestId])
  @@map("chat_lock_events")
}
