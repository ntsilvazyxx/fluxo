{
  "name": "seaf-gestao-tarefas",
  "version": "0.1.0",
  "private": true,
  "description": "Base técnica do Sistema de Gestão e Acompanhamento de Tarefas da SEAF.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:chat:safe": "npm run test:chat:safe --workspace backend",
    "test:chat:real": "npm run test:chat:real --workspace backend",
    "check": "npm run lint && npm run test && npm run build && npm run prisma:validate",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "admin:bootstrap": "npm run admin:bootstrap --workspace backend",
    "test:e2e": "playwright test",
    "test:performance": "node quality/performance.js",
    "lint:quality": "eslint --config quality/eslint.config.js quality playwright.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "type": "module"
}
