# Aplicação
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3001/api/v1
JWT_ACCESS_SECRET=gere_uma_chave_aleatoria_com_pelo_menos_32_bytes
# Chave independente: 32 bytes aleatórios em 64 caracteres hexadecimais.
# Necessária para recuperação de senha por e-mail. Guardar em cofre; não usar o JWT como chave.
AUTH_DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10
COOKIE_SECURE=0
IMAGE_STORAGE_PATH=backend/storage/images

# Storage privado do Chat (Fase 5.1.1). O recurso HTTP permanece desabilitado.
CHAT_ATTACHMENT_STORAGE_ENABLED=0
CHAT_ATTACHMENT_STORAGE_DRIVER=local
CHAT_ATTACHMENT_STORAGE_PATH=backend/storage/chat-attachments
CHAT_ATTACHMENT_STORAGE_MAX_BYTES=20971520
CHAT_ATTACHMENT_STORAGE_TIMEOUT_MS=300000
CHAT_ATTACHMENT_STORAGE_MAX_CONCURRENT_WRITES=4
CHAT_ATTACHMENT_STAGING_TTL_MINUTES=1440
CHAT_ATTACHMENT_QUARANTINE_DAYS=30

# Reservadas para subfases posteriores; não ativam quotas ou scanner nesta etapa.
CHAT_ATTACHMENT_SCANNER_ENABLED=0
CHAT_ATTACHMENT_USER_QUOTA_BYTES=
CHAT_ATTACHMENT_CONVERSATION_QUOTA_BYTES=

# MariaDB 10.11+ — substitua apenas no arquivo .env local
# O Prisma utiliza o protocolo mysql:// também para MariaDB.
DATABASE_URL="mysql://seaf_user:change_me@localhost:3306/seaf_gestao_dev"

# Testes MariaDB de integração exigem exclusivamente seaf_gestao_test.
TEST_DATABASE_URL="mysql://seaf_test_user:change_me@localhost:3306/seaf_gestao_test"

# Homologação real do Chat (opt-in; nunca use o banco operacional)
RUN_CHAT_REAL_HOMOLOGATION=0
CHAT_HOMOLOGATION_DATABASE_URL=""
RUN_DATABASE_INTEGRATION=0

# E-mail (opcional; sem SMTP o envio externo fica desativado e usa adaptador de teste)
MAIL_ENABLED=0
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=30000
MAIL_USER=
MAIL_PASS=
MAIL_FROM=seaf@instituto.local
MAIL_FROM_NAME=SEAF Gestão de Tarefas
APP_BASE_URL=http://localhost:5173

